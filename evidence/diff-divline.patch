+class _Tip:
+    """跟鼠标的小提示：图标旁边浮一句，移开或 1.5 秒后就没。"""
+    def __init__(self, 根):
+        self._根 = 根
+        self._窗 = None
+        self._after = None
+
+    def show(self, 文本, x, y):
+        self.hide()
+        try:
+            w = tk.Toplevel(self._根)
+            w.overrideredirect(True)
+            w.attributes("-topmost", True)
+            tk.Label(
+                w, text=文本, font=("微软雅黑", 9),
+                foreground="#333333", background="#FFFFFF",
+                relief="solid", borderwidth=1, padx=6, pady=2,
+            ).pack()
+            w.geometry(f"+{int(x) + 14}+{int(y) + 12}")
+            self._窗 = w
+            self._after = self._根.after(1500, self.hide)
+        except Exception:
+            self._窗 = None
+
+    def hide(self):
+        try:
+            if self._after is not None:
+                try:
+                    self._根.after_cancel(self._after)
+                except Exception:
+                    pass
+                self._after = None
+        except Exception:
+            pass
+        窗, self._窗 = self._窗, None
+        try:
+            if 窗 is not None:
+                窗.destroy()
+        except Exception:
+            pass
+
