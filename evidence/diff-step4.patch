+def _算窗口高度(源行数, 译文行数, 行高, 屏幕高):
+    """按内容行数估算窗口高度，夹在最小高度和屏幕上限之间。"""
+    固定高 = 132
+    源高 = 24 + min(max(int(源行数), 1), 12) * 行高
+    译文高 = 24 + min(max(int(译文行数), 1), 30) * 行高
+    想要 = 固定高 + 源高 + 译文高
+    上限 = max(WIN_H, min(int(屏幕高 * 0.72), 900))
+    return max(WIN_H, min(想要, 上限))
+
